+    } catch {
+      /* */
+    }
+  };
+  const onMove = () => {
+    if (!down) return;
+    try {
+      viewer?.scene?.requestRender?.();
+    } catch {
+      /* */
+    }
+  };
+  const onUp = () => {
+    if (!down) return;
+    down = false;
+    releaseContinuousRender(CAMERA_INTERACT_HOLD_ID);
+    try {
+      viewer?.scene?.requestRender?.();
+    } catch {
+      /* */
+    }
+  };

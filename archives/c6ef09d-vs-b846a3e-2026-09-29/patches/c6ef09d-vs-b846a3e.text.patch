+  canvas.addEventListener('touchstart', onDown, opts);
+  canvas.addEventListener('touchmove', onMove, opts);
+  win?.addEventListener?.('touchend', onUp, opts);
+  win?.addEventListener?.('touchcancel', onUp, opts);
